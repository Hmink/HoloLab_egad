+test("Release velocity uses real frame time consistently at 30, 60 and 144 render Hz", () => {
+  const speeds = [];
+  for (const rate of [30, 60, 144]) {
+    const f = fixture();
+    try {
+      f.physics.beginGrab(f.item);
+      for (let n = 1; n <= rate * 2; n++) {
