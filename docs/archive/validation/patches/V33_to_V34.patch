+      p.setTarget(a.o, { x: -1, y: 0.8, z: 0 }, 0, 0, 0);
+      step(140);
+      for (let i = 0; i < 20; i++) {
+        p.setTarget(a.o, { x: -1 + i * 0.07, y: 0.8, z: 0 });
+        step(1, 1 / 60);
+      }
+      p.release(a.o, true);
+      const v = a.e.body.linvel(),
+        speed = Math.hypot(v.x, v.y, v.z);
