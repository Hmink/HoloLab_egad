+    const a = add();
+    for (const target of [
+      { x: -30, y: 0, z: 0 },
+      { x: 30, y: 0, z: 0 },
+      { x: 0, y: 0, z: -30 },
+      { x: 0, y: 0, z: 30 },
+      { x: 0, y: 30, z: 0 },
+    ]) {
+      p.beginGrab(a.o);
