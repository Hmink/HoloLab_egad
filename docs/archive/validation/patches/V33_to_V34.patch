+  const T = await import(
+    pathToFileURL(path.join(root, "web/vendor/three/three.module.js"))
+  );
+  const { LabPhysics, initPhysics, FIXED_DT } = await import(
+    pathToFileURL(path.join(root, "web/src/physics.js"))
+  );
