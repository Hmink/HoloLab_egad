+      ),
+    );
+    return {
+      passed: drift < 0.005 && a.every((x) => x.e.body.isSleeping()),
+      seconds: 60,
+      drift,
+      sleeping: a.every((x) => x.e.body.isSleeping()),
+    };
+  });
+  await run(
+    "tracking interruption freezes; reacquire and stall do not throw",
+    ({ p, add, step }) => {
+      const a = add();
