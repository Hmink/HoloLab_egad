+  await writeFile(path.join(out, "soak-failure.json"), JSON.stringify({ complete: false,
+    error: String(error), durationSeconds: start ? (Date.now() - start) / 1000 : 0, samples, errors }, null, 2));
+  throw error;
+} finally {
+  await browser?.close(); server.kill();
+}
