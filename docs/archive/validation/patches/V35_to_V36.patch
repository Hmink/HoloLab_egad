+ const r=rig();for(let i=0;i<7;i++)r.feed([]);
+ assert.equal(r.interaction.owners(r.object).length,1);
+ for(let i=0;i<20;i++)r.feed([]);
+ assert.equal(r.interaction.owners(r.object).length,0);
