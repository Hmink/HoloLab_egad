# Copy to .env (git-ignored). Student data stays on this server: Ollama must run locally.
# Install Ollama, then:  ollama pull qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Context window in tokens. Must fit lesson + rubric + answer; too small silently truncates the prompt.
OLLAMA_NUM_CTX=8192
# Seconds to wait for one answer (CPU-only machines are slow; raise if you see timeouts).
OLLAMA_TIMEOUT_SEC=120
# How long the model stays loaded in memory between requests (-1 = forever).
OLLAMA_KEEP_ALIVE=30m
# Only set to 1 if Ollama runs on another PRIVATE machine you control.
# OLLAMA_ALLOW_REMOTE=1

# ---- Accounts (API v3.1). Leave empty to run the lab without accounts. -----------------------------
# PostgreSQL (create the database first, see docs/BACKEND_XAC_THUC.md). Use your own password here;
# .env is git-ignored, never commit it.
# HOLOLAB_DATABASE_URL=postgresql+psycopg://hololab:DOI_MAT_KHAU_NAY@127.0.0.1:5432/hololab
# Only behind your own HTTPS reverse proxy (Caddy/nginx) that sets X-Forwarded-*:
# HOLOLAB_TRUST_FORWARDED=1
# Testing only: allow sign-in over plain http from another machine (the session cookie travels unencrypted).
# HOLOLAB_ALLOW_INSECURE_HTTP=1
