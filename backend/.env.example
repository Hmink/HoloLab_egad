# Copy to .env (git-ignored). Student data stays on this server: Ollama must run locally.
# Install Ollama, then:  ollama pull qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Context window in tokens. Must fit lesson + rubric + answer; too small silently truncates the prompt.
OLLAMA_NUM_CTX=8192
# Seconds to wait for one answer (CPU-only machines are slow; raise if you see timeouts).
OLLAMA_TIMEOUT_SEC=120
# How long the model stays loaded in memory between requests (-1 = forever).
OLLAMA_KEEP_ALIVE=30m
# Only set to 1 if Ollama runs on another PRIVATE machine you control.
# OLLAMA_ALLOW_REMOTE=1
