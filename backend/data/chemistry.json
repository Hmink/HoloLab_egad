  "safety_rules": [
    {
      "id": "water_into_concentrated_acid",
      "when": {
        "action": "pour",
        "source_has_tag": "water",
        "target_has_tag": "concentrated_acid"
      },
      "decision": "block",
      "ppe_can_override": false,
      "message_vi": "Thêm nước vào axit đậm đặc có thể tỏa nhiệt cục bộ rất mạnh, làm bắn chất ăn mòn. Hủy thao tác ảo; kính/găng tay không mở khóa lỗi này.",
      "source_url": "https://www.cdc.gov/niosh/npg/npgd0577.html"
    },
    {
      "id": "oxidizer_with_combustible",
      "when": {
        "unordered_pair_tags": [
          "strong_oxidizer",
          "combustible"
        ]
      },
      "decision": "block",
      "ppe_can_override": false,
      "message_vi": "Hỗn hợp chất oxi hóa mạnh và chất dễ cháy bị khóa trong chế độ học sinh."
    },
    {
      "id": "restricted_chemical",
      "when": {
        "either_has_tag": "restricted_student"
      },
      "decision": "block",
      "ppe_can_override": false,
      "message_vi": "Hóa chất thuộc nhóm hạn chế: chỉ xem tình huống cảnh báo, không chạy phản ứng."
    },
    {
      "id": "toxic_gas",
      "when": {
        "reaction_has_toxic_gas": true
      },
      "decision": "block",
      "ppe_can_override": false,
      "message_vi": "Phản ứng có sản phẩm khí độc bị khóa trong chế độ học sinh."
    },
    {
      "id": "gas_in_sealed_vessel",
      "when": {
        "gas_product_and_sealed": true
      },
      "decision": "block",
      "ppe_can_override": false,
      "message_vi": "Khóa mô hình sinh khí trong bình kín; chưa có mô hình áp suất/bền bình."
    }
  ],
